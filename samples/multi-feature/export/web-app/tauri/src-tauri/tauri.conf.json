{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "multi-feature-tauri",
  "version": "0.1.0",
  "identifier": "com.carti.ribs.samples.multi.tauri",
  "build": {
    "frontendDist": "../../react/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "RIBs Multi-Feature",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
